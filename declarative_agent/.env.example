# Specialized Bikes declarative agent — externalised configuration.
#
# Copy this file to `.env` and fill in the values, then run `./provision.sh`.
# The script feeds these values to the Microsoft 365 Agents Toolkit CLI (atk),
# which substitutes the matching ${{...}} placeholders in manifest.json,
# declarative-agent.json and mcp-plugin.json when it builds the app package.

# App (manifest) version — used for manifest.json `version` and the agent name.
# Must be an incrementing semantic version (e.g. 1.0.0, 1.0.1, 1.1.0).
APP_VERSION=1.0.0

# Application Gateway URL endpoint for the remote MCP server.
# This is the public MCP Streamable HTTP endpoint that sits in front of the
# Azure Function App (see ../deploy/deploy-gateway.sh). Include the /mcp route.
# Examples:
#   http://<app-gateway-ip>/mcp
#   https://<your-host>.azurewebsites.net/mcp
REMOTE_MCP_URL=https://your-app-gateway-endpoint/mcp

# Target atk environment name (env/.env.<TEAMSFX_ENV> is generated/updated).
TEAMSFX_ENV=dev
